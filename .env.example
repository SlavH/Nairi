# Database (Supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# For running migrations (psql / npm run migrate): get from Supabase → Project Settings → Database → Connection string
DATABASE_URL=

# Authentication: uses Supabase Auth (sign up, sign in, email verification, captcha).
# Configure in Supabase Dashboard → Authentication → Settings.
# Enable Google OAuth: Authentication → Providers → Google (add Client ID & Secret).
# Enable email verification: Authentication → Settings → Email Auth → Enable email confirmations.
# Enable captcha: Authentication → Settings → Security & Policy → Enable captcha (hcaptcha or Cloudflare turnstile).

# Stripe (payments and webhook)
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# Nairi HF Space – web-grounded chat (SearXNG + 2-pass: PLAN → FINAL). Backend has its own system prompt (Nairi/Наири).
# Base URL only (no /health or /chat). Example: https://slavnairi-nairi-generation.hf.space
NAIRI_HF_BASE_URL=https://slavnairi-nairi-generation.hf.space
# Fallback if NAIRI_HF_BASE_URL not set:
# AI_BASE_URL=

# SearXNG Space – web search for Nairi chat. GET {SEARXNG_BASE_URL}/search?q=...&format=json&language=en
# Example: https://your-searxng-space.hf.space (no trailing slash)
SEARXNG_BASE_URL=https://your-searxng-space.hf.space

# Nairi HF Router – async generation (text, image, video, code, etc.). POST /generate → job_id → poll /status, /result.
# Base URL only (no trailing slash). Example: https://slavnairi-nairi-router.hf.space
NAIRI_ROUTER_BASE_URL=https://slavnairi-nairi-router.hf.space

# Nairi AI Backend — OpenAI-compatible AI endpoint (required for all AI features)
# AMD GPU: https://your-bitnet-endpoint/v1 (vLLM on MI300X)
# Colab-style: https://your-ngrok-url.ngrok.io
# Local: http://localhost:11434/v1 (Ollama)
# Cloud: https://api.groq.com/openai/v1
NAIRI_AI_BASE_URL=
NAIRI_AI_API_KEY=
NAIRI_AI_MODEL=nairi-llama

# Groq (fast inference fallback)
GROQ_API_KEY=

# OpenRouter (multi-model routing fallback)
OPENROUTER_API_KEY=

# Factory Agent Configuration (optional — uses NAIRI_AI_BASE_URL by default)
# FACTORY_AGENT_MODEL=nairi-llama
# FACTORY_GPU_INFO=AMD MI300X

# OpenCode is now client-side via WebContainers (no server needed)
# Free Zen models from opencode.ai are used by default:
# - opencode/big-pickle (default, 200k context, reasoning)
# - opencode/deepseek-v4-flash-free, opencode/mimo-v2.5-free
# - opencode/nemotron-3-ultra-free, opencode/north-mini-code-free
# No API keys required for free models.

# Ollama-compatible backend (OpenAI-compatible API for GPU-accelerated inference)
# Base URL for Ollama API (e.g., ngrok URL without /v1/chat/completions path)
OLLAMA_BASE_URL=https://your-ngrok-url.ngrok.io
# Model identifier (e.g., llama3, llama3:latest, mistral)
OLLAMA_MODEL=llama3:latest
# Enable streaming responses (recommended for real-time UI)
OLLAMA_STREAM=true
# Optional: Custom system prompt for Ollama backend
# OLLAMA_SYSTEM_PROMPT="You are Nairi AI, an advanced assistant for Armenian developers and students."

# Request timeout (ms). Colab can be slow; 60000 = 60s default. Optional Colab-only override:
# COLAB_REQUEST_TIMEOUT_MS=90000
AI_REQUEST_TIMEOUT=60000
AI_MAX_RETRIES=2

# Web search for builder (layout/structure research for portfolio, landing, etc.)
# Optional: SERPER_API_KEY (serper.dev) or TAVILY_API_KEY (tavily.com)
SERPER_API_KEY=
# TAVILY_API_KEY=

# Replicate (video generation)
REPLICATE_API_TOKEN=


# Rate limiting (production) - when set, use Redis for rate limit store so limits apply across instances
REDIS_URL=

# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# OpenCode API (client-side WebContainers)
OPENCODE_API_URL=

# Auth bypass for development
BYPASS_AUTH=false

# Public app URL (used for CORS, redirects, etc.)
NEXT_PUBLIC_APP_URL=

# hCaptcha for auth forms
HCAPTCHA_SECRET_KEY=

# AI Provider API Keys (various services)
ELEVENLABS_API_KEY=
HUGGINGFACE_API_KEY=
MUBERT_API_KEY=
COQUI_API_KEY=
PLAYHT_API_KEY=
PLAYHT_USER_ID=
STABILITY_API_KEY=
DID_API_KEY=
HEYGEN_API_KEY=
VOICERSS_API_KEY=
MESHY_API_KEY=
BLOCKADE_LABS_API_KEY=
SUNO_API_KEY=

# Builder Agent Settings
BUILDER_RETRY_ON_VALIDATION_FAILURE=true
BUILDER_RETRY_FOR_WOW=true

# Logging & Monitoring
NAIRI_LOG_LATENCY=false
NAIRI_LOG_USAGE=false
NAIRI_PROMPT_VERSION=v1

# Analytics
NEXT_PUBLIC_GA_ID=
NEXT_PUBLIC_MIXPANEL_TOKEN=
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# External Links
NAIRI_STATUS_PAGE_URL=
NAIRI_FEEDBACK_WIDGET=
NAIRI_SUPPORT_EMAIL=
NAIRI_COMMUNITY_URL=
NAIRI_STUDIO_EMBED_ORIGINS=

# Conversation Features
NAIRI_CONVERSATION_FOLDERS=true
NAIRI_CONVERSATION_TAGS=true

# API Sandbox
NAIRI_API_SANDBOX_BASE_URL=

# CORS & Security
ALLOWED_ORIGINS=

# Workspace
WORKSPACE_BASE_PATH=

# Colab AI
COLAB_AI_BASE_URL=

# Brave Search API (for web search features)
BRAVE_API_KEY=

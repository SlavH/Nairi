# =============================================================================
# Nairi — environment configuration
# Only variables actually read by the code are listed here.
# The app runs without any keys for static pages; AI features need an LLM backend.
# =============================================================================

# --- Database & Auth (Supabase) ---------------------------------------------
# Required for sign-in, chat history, marketplace, learn, flow, dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# For running migrations (psql / npm run migrate): Supabase → Settings → Database → Connection string
DATABASE_URL=

# Supabase Auth: configure providers/captcha in the Supabase Dashboard.
# hCaptcha (server verify + browser widget):
HCAPTCHA_SECRET_KEY=
NEXT_PUBLIC_HCAPTCHA_SITE_KEY=

# Development auth bypass (NEVER enable in production)
BYPASS_AUTH=false

# --- AI backends -------------------------------------------------------------
# Primary: any OpenAI-compatible endpoint (vLLM on AMD MI300X, Ollama, Groq, ngrok/Colab...).
# Used by /api/chat and every generate-* route via lib/ai/groq-direct.ts.
NAIRI_AI_BASE_URL=
NAIRI_AI_API_KEY=
NAIRI_AI_MODEL=nairi-llama

# Fallback chain inside groq-direct:
COLAB_AI_BASE_URL=            # Colab/Ollama proxy (optional)
# OLLAMA_BASE_URL=            # direct Ollama-compatible backend
# OLLAMA_MODEL=llama3:latest
NAIRI_ROUTER_BASE_URL=        # async HF-Space job router (media generation)

# Web-grounded Nairi mode (/api/nairi/*): HF Space running SearXNG 2-pass chat.
# Example: https://slavnairi-nairi-generation.hf.space
NAIRI_HF_BASE_URL=

# Builder research (optional; Serper or Tavily)
SERPER_API_KEY=
TAVILY_API_KEY=

# Request behavior
AI_REQUEST_TIMEOUT=60000
AI_MAX_RETRIES=2
# Optional Colab-only override:
# COLAB_REQUEST_TIMEOUT_MS=90000

# --- Media generation tiers ---------------------------------------------------
# Fallback order is Router → paid provider → keyless (Pollinations / Streamlabs).
REPLICATE_API_TOKEN=          # video + upscale tiers
HUGGINGFACE_API_KEY=          # HF inference tier (studio image, etc.)
STABILITY_API_KEY=            # SDXL tier in /api/generate-image
VOICERSS_API_KEY=             # TTS tier in /api/generate-audio

# --- Payments (Stripe) ---------------------------------------------------------
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Rate limiting --------------------------------------------------------------
# When set, limits are shared across instances via Redis; otherwise in-memory.
REDIS_URL=

# --- OpenCode (Builder agent, client-side WebContainers) ------------------------
# Free Zen models from opencode.ai work by default — no key needed.
OPENCODE_API_URL=

# --- Misc ------------------------------------------------------------------------
# Public app URL (CORS, redirects). Example: http://localhost:3000
NEXT_PUBLIC_APP_URL=
# Comma-separated extra allowed origins for API CORS
ALLOWED_ORIGINS=
# Workflow executor is disabled unless explicitly enabled
NAIRI_ENABLE_WORKFLOW_EXEC=false
# Sentry (optional)
NEXT_PUBLIC_SENTRY_DSN=
# Logging verbosity
NAIRI_LOG_LATENCY=false
NAIRI_PROMPT_VERSION=v1

{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "name": "opencode",
      "npm": "@ai-sdk/openai-compatible",
      "models": {
        "big-pickle": {
          "name": "opencode/big-pickle"
        }
      }
    }
  },
  "server": {

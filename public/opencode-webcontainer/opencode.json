{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "opencode": {
      "name": "opencode",
      "npm": "@ai-sdk/openai-compatible",
      "options": {
        "apiKey": "public",
        "baseURL": "https://opencode.ai/zen/v1"
      },
      "models": {
        "big-pickle": { "name": "opencode/big-pickle" },
        "deepseek-v4-flash-free": { "name": "opencode/deepseek-v4-flash-free" },
        "mimo-v2.5-free": { "name": "opencode/mimo-v2.5-free" },
        "nemotron-3-ultra-free": { "name": "opencode/nemotron-3-ultra-free" },
        "north-mini-code-free": { "name": "opencode/north-mini-code-free" }
      }
    }
  },
  "model": "opencode/big-pickle",
  "server": {
    "port": 4096,
    "hostname": "0.0.0.0"
  },
  "permission": {
    "bash": "allow",
    "read": "allow",
    "edit": "allow",
    "write": "allow",
    "glob": "allow",
    "grep": "allow",
    "webfetch": "allow",
    "websearch": "allow"
  }
}

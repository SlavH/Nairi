{
  "model": "opencode/big-pickle",
  "provider": "opencode",
  "permissions": {
    "allow": [
      "sudo",
      "apt-get",
      "apt",
      "pip",
      "npm",
      "npx",
      "git",
      "curl",
      "wget",
      "docker",
      "docker-compose",
      "mkdir",
      "touch",
      "cp",
      "mv",
      "rm",
      "chmod",
      "chown",
      "cat",
      "echo",
      "ls",
      "find",
      "grep",
      "sed",
      "awk",
      "sort",
      "wc",
      "head",
      "tail",
      "ps",
      "kill",
      "pkill",
      "node",
      "python3",
      "python",
      "pip3",
      "tsx",
      "npx",
      "make",
      "cmake",
      "gcc",
      "g++",
      "rustc",
      "cargo",
      "go",
      "java",
      "javac",
      "mvn",
      "gradle"
    ],
    "deny": [
      "rm -rf /",
      "rm -rf /*",
      "mkfs*",
      "dd",
      "fdisk",
      "parted",
      "mkswap"
    ]
  },
  "cors": {
    "origins": ["*"],
    "methods": ["GET", "POST", "PUT", "DELETE", "PATCH", "OPTIONS"],
    "headers": ["Content-Type", "Authorization", "X-Session-Id", "X-User-Id"]
  },
  "server": {
    "port": 4096,
    "host": "0.0.0.0",
    "workspaceBasePath": "/workspaces"
  }
}
